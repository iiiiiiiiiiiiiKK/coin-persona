    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.21.5",
    "puppeteer-core": "23.11.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=18"
